        "@crates//:objc2-0.6.4",
        "@crates//:objc2-core-foundation-0.3.2",
        "@crates//:objc2-core-graphics-0.3.2",
        "@crates//:objc2-core-media-0.3.2",
        "@crates//:objc2-core-video-0.3.2",
        "@crates//:objc2-foundation-0.3.2",
        "@crates//:objc2-video-toolbox-0.3.2",
        "@crates//:objc2-vision-0.3.2",
        "@crates//:xcap-0.9.3",
    ],
    "//conditions:default": [],
})

_APP_SERVER_DEPS = DEP_DATA["codex-rs/app-server"]["deps"] + _MACOS_RECORDING_DEPS
_APP_SERVER_TEST_DEPS = _APP_SERVER_DEPS + DEP_DATA["codex-rs/app-server"]["dev_deps"]

codex_rust_crate(
